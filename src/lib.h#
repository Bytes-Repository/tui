        style: style_new(), cursor_style: style_fg(style_bg(style_new(), "white"), "black")
    }
end

pub fn textinput_value(ti: any) -> string is
    return ti.value
end

pub fn textinput_set_value(ti: any, value: string) -> any is
    return TextInput {
        value: value, cursor: char_count(value), placeholder: ti.placeholder,
        focused: ti.focused, style: ti.style, cursor_style: ti.cursor_style
    }
end

pub fn textinput_focus(ti: any, on: bool) -> any is
    return TextInput {
        value: ti.value, cursor: ti.cursor, placeholder: ti.placeholder,
        focused: on, style: ti.style, cursor_style: ti.cursor_style
    }
end

pub fn textinput_set_style(ti: any, style: any) -> any is
    return TextInput {
        value: ti.value, cursor: ti.cursor, placeholder: ti.placeholder,
        focused: ti.focused, style: style, cursor_style: ti.cursor_style
    }
end

;; Feed a `tui` message into the text field. No-ops when unfocused or when
;; `msg` isn't a key message, so it's always safe to call from `update`
;; without guarding it yourself.
pub fn textinput_update(ti: any, msg: any) -> any is
    if !ti.focused || msg.kind != "key" is return ti end
    let key: string = msg.key
    let v: string = ti.value
    let c: int = ti.cursor

    if key == "backspace" is
        if c > 0 is return textinput_with(ti, v[0..c - 1] + v[c..v.len()], c - 1) end
        return ti
    end
    if key == "delete" is
        if c < char_count(v) is return textinput_with(ti, v[0..c] + v[c + 1..v.len()], c) end
        return ti
    end
    let n: int = char_count(v)
    if key == "left" is return textinput_with(ti, v, maxi(0, c - 1)) end
    if key == "right" is return textinput_with(ti, v, mini(n, c + 1)) end
    if key == "home" is return textinput_with(ti, v, 0) end
    if key == "end" is return textinput_with(ti, v, n) end
    if key == "ctrl+u" is return textinput_with(ti, v[c..v.len()], 0) end
    if key == "ctrl+a" is return textinput_with(ti, v, 0) end
    if key == "ctrl+e" is return textinput_with(ti, v, n) end
    if key == "space" is return textinput_with(ti, v[0..c] + " " + v[c..v.len()], c + 1) end

    if !is_special_key(key) is
        let nv: string = v[0..c] + key + v[c..v.len()]
        return textinput_with(ti, nv, c + char_count(key))
    end
    return ti
end

fn textinput_with(ti: any, value: string, cursor: int) -> any is
    return TextInput {
        value: value, cursor: cursor, placeholder: ti.placeholder,
        focused: ti.focused, style: ti.style, cursor_style: ti.cursor_style
    }
end

pub fn textinput_view(ti: any) -> string is
    if ti.value == "" is
        if !ti.focused is return style_render(ti.style, ti.placeholder) end
        return style_render(ti.cursor_style, " ") + style_render(ti.style, ti.placeholder)
    end
    if !ti.focused is return style_render(ti.style, ti.value) end

    let before: string = ti.value[0..ti.cursor]
    let has_at: bool = ti.cursor < char_count(ti.value)
    let at_cursor: string = if has_at is ti.value[ti.cursor..ti.cursor + 1] else is " " end
    let after: string = if has_at is ti.value[ti.cursor + 1..ti.value.len()] else is "" end
    return style_render(ti.style, before) + style_render(ti.cursor_style, at_cursor) + style_render(ti.style, after)
end


;; ── component: viewport (scrollable text area) ───────────────────────────

struct Viewport is
    pub lines: [string]
    pub top: int
    pub width: int
    pub height: int
    pub style: any
end

pub fn viewport_new(width: int, height: int) -> any is
    return Viewport { lines: [], top: 0, width: width, height: height, style: style_new() }
end

pub fn viewport_set_content(vp: any, content: string) -> any is
    return Viewport { lines: str_split(content, "\n"), top: 0, width: vp.width, height: vp.height, style: vp.style }
end

pub fn viewport_set_style(vp: any, style: any) -> any is
    return Viewport { lines: vp.lines, top: vp.top, width: vp.width, height: vp.height, style: style }
end

pub fn viewport_scroll(vp: any, delta: int) -> any is
    let max_top: int = maxi(0, vp.lines.len() - vp.height)
    let new_top: int = clampi(vp.top + delta, 0, max_top)
    return Viewport { lines: vp.lines, top: new_top, width: vp.width, height: vp.height, style: vp.style }
end

pub fn viewport_at_top(vp: any) -> bool is
    return vp.top <= 0
end

pub fn viewport_at_bottom(vp: any) -> bool is
    return vp.top >= maxi(0, vp.lines.len() - vp.height)
end

pub fn viewport_update(vp: any, msg: any) -> any is
    if msg.kind != "key" is return vp end
    if msg.key == "up" is return viewport_scroll(vp, -1) end
    if msg.key == "down" is return viewport_scroll(vp, 1) end
    if msg.key == "pgup" is return viewport_scroll(vp, -vp.height) end
    if msg.key == "pgdown" is return viewport_scroll(vp, vp.height) end
    if msg.key == "home" is return viewport_scroll(vp, -vp.lines.len()) end
    if msg.key == "end" is return viewport_scroll(vp, vp.lines.len()) end
    return vp
end

pub fn viewport_view(vp: any) -> string is
    let mut out: [string] = []
    let mut i: int = 0
    while i < vp.height is
        let idx: int = vp.top + i
        let line: string = if idx < vp.lines.len() is vp.lines[idx] else is "" end
        out.push(pad_right(line, vp.width))
        i = i + 1
    end
    return style_render(vp.style, iter_join(out, "\n"))
end


;; ── component: selectable list ───────────────────────────────────────────

struct ListModel is
    pub items: [string]
    pub cursor: int
    pub top: int
    pub height: int
    pub style: any
    pub selected_style: any
end

pub fn list_new(items: [string]) -> any is
    return ListModel {
        items: items, cursor: 0, top: 0, height: mini(10, items.len()),
        style: style_new(), selected_style: style_bold(style_fg(style_new(), "cyan"), true)
    }
end

pub fn list_set_height(l: any, height: int) -> any is
    return ListModel { items: l.items, cursor: l.cursor, top: l.top, height: height, style: l.style, selected_style: l.selected_style }
end

pub fn list_set_items(l: any, items: [string]) -> any is
    return ListModel { items: items, cursor: 0, top: 0, height: l.height, style: l.style, selected_style: l.selected_style }
end

pub fn list_set_style(l: any, style: any, selected_style: any) -> any is
    return ListModel { items: l.items, cursor: l.cursor, top: l.top, height: l.height, style: style, selected_style: selected_style }
end

fn list_reclamp(l: any, cursor: int) -> any is
    let n: int = l.items.len()
    let c: int = clampi(cursor, 0, maxi(0, n - 1))
    let mut top: int = l.top
    if c < top is top = c end
    if c >= top + l.height is top = c - l.height + 1 end
    top = clampi(top, 0, maxi(0, n - l.height))
    return ListModel { items: l.items, cursor: c, top: top, height: l.height, style: l.style, selected_style: l.selected_style }
end

pub fn list_update(l: any, msg: any) -> any is
    if msg.kind != "key" is return l end
    if msg.key == "up" is return list_reclamp(l, l.cursor - 1) end
    if msg.key == "down" is return list_reclamp(l, l.cursor + 1) end
    if msg.key == "pgup" is return list_reclamp(l, l.cursor - l.height) end
    if msg.key == "pgdown" is return list_reclamp(l, l.cursor + l.height) end
    if msg.key == "home" is return list_reclamp(l, 0) end
    if msg.key == "end" is return list_reclamp(l, l.items.len() - 1) end
    return l
end

pub fn list_selected_index(l: any) -> int is
    return l.cursor
end

pub fn list_selected(l: any) -> string is
    if l.items.len() == 0 is return "" end
    return l.items[l.cursor]
end

pub fn list_view(l: any) -> string is
    let mut out: [string] = []
    let n: int = l.items.len()
    let mut i: int = l.top
    let end_idx: int = mini(n, l.top + l.height)
    while i < end_idx is
        let raw: string = l.items[i]
        if i == l.cursor is
            out.push(style_render(l.selected_style, "› " + raw))
        else is
            out.push("  " + raw)
        end
        i = i + 1
    end
    return style_render(l.style, iter_join(out, "\n"))
end


;; ── component: paginator ─────────────────────────────────────────────────

struct Paginator is
    pub page: int          ;; 0-based
    pub total_pages: int
    pub active_style: any
    pub inactive_style: any
end

pub fn paginator_new(total_pages: int) -> any is
    return Paginator {
        page: 0, total_pages: maxi(1, total_pages),
        active_style: style_fg(style_new(), "cyan"),
        inactive_style: style_fg(style_new(), "bright_black")
    }
end

pub fn paginator_page(p: any) -> int is
    return p.page
end

pub fn paginator_set_page(p: any, page: int) -> any is
    return Paginator {
        page: clampi(page, 0, p.total_pages - 1), total_pages: p.total_pages,
        active_style: p.active_style, inactive_style: p.inactive_style
    }
end

pub fn paginator_next(p: any) -> any is
    return paginator_set_page(p, p.page + 1)
end

pub fn paginator_prev(p: any) -> any is
    return paginator_set_page(p, p.page - 1)
end

pub fn paginator_update(p: any, msg: any) -> any is
    if msg.kind != "key" is return p end
    if msg.key == "left" is return paginator_prev(p) end
    if msg.key == "right" is return paginator_next(p) end
    return p
end

pub fn paginator_view(p: any) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < p.total_pages is
        let dot: string = if i == p.page is style_render(p.active_style, "●") else is style_render(p.inactive_style, "○") end
        out = out + dot
        if i < p.total_pages - 1 is out = out + " " end
        i = i + 1
    end
    return out
end


;; ── component: help bar ──────────────────────────────────────────────────
;;
;; Bindings are given as parallel arrays: `keys[i]` is the short key label
;; shown ("↑/↓", "enter", "q") and `descriptions[i]` is what it does
;; ("move", "select", "quit").

pub fn help_view(keys: [string], descriptions: [string]) -> string is
    let key_style: any = style_bold(style_fg(style_new(), "cyan"), true)
    let desc_style: any = style_fg(style_new(), "bright_black")
    let sep_style: any = style_fg(style_new(), "bright_black")
    let mut parts: [string] = []
    let n: int = mini(keys.len(), descriptions.len())
    let mut i: int = 0
    while i < n is
        parts.push(style_render(key_style, keys[i]) + " " + style_render(desc_style, descriptions[i]))
        i = i + 1
    end
    return iter_join(parts, style_render(sep_style, "  •  "))
end


;; ── component: timer / stopwatch ─────────────────────────────────────────

struct Timer is
    pub started_at_ms: int
    pub stopped_elapsed_ms: int
    pub running: bool
end

pub fn timer_new() -> any is
    return Timer { started_at_ms: __builtin_time_now_ms(), stopped_elapsed_ms: 0, running: true }
end

pub fn timer_start(t: any) -> any is
    if t.running is return t end
    return Timer { started_at_ms: __builtin_time_now_ms() - t.stopped_elapsed_ms, stopped_elapsed_ms: 0, running: true }
end

pub fn timer_stop(t: any) -> any is
    if !t.running is return t end
    return Timer { started_at_ms: t.started_at_ms, stopped_elapsed_ms: __builtin_time_now_ms() - t.started_at_ms, running: false }
end

pub fn timer_reset(t: any) -> any is
    return Timer { started_at_ms: __builtin_time_now_ms(), stopped_elapsed_ms: 0, running: true }
end

pub fn timer_elapsed_ms(t: any) -> int is
    if t.running is return __builtin_time_now_ms() - t.started_at_ms end
    return t.stopped_elapsed_ms
end

;; "mm:ss" formatting of the elapsed time.
pub fn timer_view(t: any) -> string is
    let total_s: int = timer_elapsed_ms(t) / 1000
    let m: int = total_s / 60
    let s: int = total_s % 60
    let mm: string = if m < 10 is "0" + to_string(m) else is to_string(m) end
    let ss: string = if s < 10 is "0" + to_string(s) else is to_string(s) end
    return mm + ":" + ss
end


