fn clampi(n: int, lo: int, hi: int) -> int is
    if n < lo is return lo end
    if n > hi is return hi end
    return n
end

fn maxi(a: int, b: int) -> int is
    if a > b is return a end
    return b
end

fn mini(a: int, b: int) -> int is
    if a < b is return a end
    return b
end

fn is_ws_ch(ch: string) -> bool is
    return ch == " " || ch == "\t" || ch == "\n" || ch == "\r"
end

;; NOTE ON UNICODE: `s.len()` returns the *byte* length of `s` (UTF-8),
;; while `s[i..j]` slices by *character* — so anything that needs an
;; actual character count (padding math, cursor movement, ...) uses this
;; instead of `.len()`. `.len()` is still fine, and used below, as a safe
;; *upper bound* in a slice's end index (e.g. `s[i..s.len()]` for "rest of
;; the string") since out-of-range slice ends just clamp to the real
;; length rather than panicking.
fn char_count(s: string) -> int is
    let mut i: int = 0
    while s[i..i + 1] != "" is
        i = i + 1
    end
    return i
end

fn trim_str(s: string) -> string is
    let n: int = char_count(s)
    let mut i: int = 0
    while i < n && is_ws_ch(s[i..i + 1]) is
        i = i + 1
    end
    let mut j: int = n
    while j > i && is_ws_ch(s[j - 1..j]) is
        j = j - 1
    end
    return s[i..j]
end

fn rep_str(s: string, n: int) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < n is
        out = out + s
        i = i + 1
    end
    return out
end

fn pad_right(s: string, width: int) -> string is
    let diff: int = width - visible_len(s)
    if diff <= 0 is return s end
    return s + rep_str(" ", diff)
end

fn pad_left(s: string, width: int) -> string is
    let diff: int = width - visible_len(s)
    if diff <= 0 is return s end
    return rep_str(" ", diff) + s
end

fn pad_center(s: string, width: int) -> string is
    let diff: int = width - visible_len(s)
    if diff <= 0 is return s end
    let left: int = diff / 2
    let right: int = diff - left
    return rep_str(" ", left) + s + rep_str(" ", right)
end

fn is_digit_ch(ch: string) -> bool is
    return ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" ||
           ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9"
end

fn is_all_digits(s: string) -> bool is
    let n: int = s.len()
    if n == 0 is return false end
    let mut i: int = 0
    while i < n is
        if !is_digit_ch(s[i..i + 1]) is return false end
        i = i + 1
    end
    return true
end

fn hex_digit_val(ch: string) -> int is
    if ch == "0" is return 0 end
    if ch == "1" is return 1 end
    if ch == "2" is return 2 end
    if ch == "3" is return 3 end
    if ch == "4" is return 4 end
    if ch == "5" is return 5 end
    if ch == "6" is return 6 end
    if ch == "7" is return 7 end
    if ch == "8" is return 8 end
    if ch == "9" is return 9 end
    if ch == "a" || ch == "A" is return 10 end
    if ch == "b" || ch == "B" is return 11 end
    if ch == "c" || ch == "C" is return 12 end
    if ch == "d" || ch == "D" is return 13 end
    if ch == "e" || ch == "E" is return 14 end
    if ch == "f" || ch == "F" is return 15 end
    return 0
end

fn hex_pair_val(s: string, i: int) -> int is
    return hex_digit_val(s[i..i + 1]) * 16 + hex_digit_val(s[i + 1..i + 2])
end

;; Strip ANSI SGR escape sequences ("\x1b[...m") so width/padding math is
;; done against what actually shows up on screen, not the byte count.
fn strip_ansi(s: string) -> string is
    let n: int = char_count(s)
    let mut out: string = ""
    let mut i: int = 0
    while i < n is
        let ch: string = s[i..i + 1]
        if ch == "\x1b" is
            let mut j: int = i + 1
            if j < n && s[j..j + 1] == "[" is
                j = j + 1
                while j < n && s[j..j + 1] != "m" is
                    j = j + 1
                end
                if j < n is j = j + 1 end
            end
            i = j
        else is
            out = out + ch
            i = i + 1
        end
    end
    return out
end

fn visible_len(s: string) -> int is
    return char_count(strip_ansi(s))
end


;; ── low-level terminal control ──────────────────────────────────────────

fn write_raw(s: string) is
    __builtin_io_write_no_nl(s)
end

fn flush_out() is
    __builtin_io_flush()
end

;; Terminal width in columns (best-effort; falls back to 80 if it can't be
;; determined, e.g. when stdout isn't a real tty).
pub fn term_width() -> int is
    let out: string = trim_str(__builtin_process_run("stty size -F /dev/tty 2>/dev/null"))
    if out == "" is return 80 end
    let parts: [string] = str_split(out, " ")
    if parts.len() < 2 is return 80 end
    let w: int = __builtin_conv_str_to_int(parts[1])
    if w <= 0 is return 80 end
    return w
end

;; Terminal height in rows (best-effort; falls back to 24).
pub fn term_height() -> int is
    let out: string = trim_str(__builtin_process_run("stty size -F /dev/tty 2>/dev/null"))
    if out == "" is return 24 end
    let parts: [string] = str_split(out, " ")
    if parts.len() < 1 is return 24 end
    let h: int = __builtin_conv_str_to_int(parts[0])
    if h <= 0 is return 24 end
    return h
end

;; (width, height) in one call — one `stty` shell-out instead of two.
pub fn term_size() -> (int, int) is
    let out: string = trim_str(__builtin_process_run("stty size -F /dev/tty 2>/dev/null"))
    if out == "" is return (80, 24) end
    let parts: [string] = str_split(out, " ")
    if parts.len() < 2 is return (80, 24) end
    let h: int = __builtin_conv_str_to_int(parts[0])
    let w: int = __builtin_conv_str_to_int(parts[1])
    if w <= 0 is return (80, 24) end
    if h <= 0 is return (80, 24) end
    return (w, h)
end

;; Put the terminal into raw mode: no line buffering, no local echo, and a
;; ~100ms read timeout (`min 0 time 1`) so a single key-read never blocks
;; the render loop for long — this is what gives `poll_key` its "is a key
;; available right now" polling behaviour, and it's also what drives the
;; program loop's own ~10Hz tick cadence when no key is pressed. `opost
;; onlcr` is re-enabled on top of `raw` so this program's own "\n" bytes
;; still come out as "\r\n" — `raw` alone turns that off, which without
;; this would stair-step every line of output.
;;
;; Returns the terminal's previous settings (from `stty -g`) — hang on to
;; this and pass it to `disable_raw_mode` to restore the user's shell
;; exactly as it was, rather than guessing with `stty sane`.
pub fn enable_raw_mode() -> string is
    let saved: string = trim_str(__builtin_process_run("stty -g -F /dev/tty 2>/dev/null"))
    let _r: string = __builtin_process_run("stty raw -echo min 0 time 1 opost onlcr -F /dev/tty 2>/dev/null")
    return saved
end

;; Restore whatever `enable_raw_mode` returned. Falls back to `stty sane`
;; if `saved` is empty (e.g. stdout wasn't a real tty to begin with).
pub fn disable_raw_mode(saved: string) is
    if saved != "" is
        let _r: string = __builtin_process_run("stty '" + saved + "' -F /dev/tty 2>/dev/null")
    else is
        let _r2: string = __builtin_process_run("stty sane -F /dev/tty 2>/dev/null")
    end
end

pub fn enter_alt_screen() is
    write_raw("\x1b[?1049h")
end

pub fn exit_alt_screen() is
    write_raw("\x1b[?1049l")
end

pub fn hide_cursor() is
    write_raw("\x1b[?25l")
end

pub fn show_cursor() is
    write_raw("\x1b[?25h")
end

pub fn clear_screen() is
    write_raw("\x1b[2J\x1b[H")
end

pub fn move_home() is
    write_raw("\x1b[H")
end

pub fn move_to(row: int, col: int) is
    write_raw("\x1b[" + to_string(row) + ";" + to_string(col) + "H")
end

pub fn bell() is
    write_raw("\x07")
end

pub fn set_title(title: string) is
    write_raw("\x1b]0;" + title + "\x07")
end

;; Write a full frame: cursor home + the given text, flushed immediately.
;; Used internally by `run`, exposed for callers rolling their own loop.
pub fn draw(frame: string) is
    write_raw("\x1b[H\x1b[2J")
    write_raw(frame)
    flush_out()
end


;; ── keyboard input ───────────────────────────────────────────────────────
;;
;; Key names this library produces: "up" "down" "left" "right" "home" "end"
;; "pgup" "pgdown" "delete" "backspace" "tab" "enter" "esc" "space"
;; "ctrl+c" "ctrl+a" "ctrl+e" "ctrl+d" "ctrl+u" "ctrl+k" "ctrl+w", or a plain
;; single printable character ("a", "Z", "1", "?", ...).

fn read_one_byte() -> string is
    return __builtin_io_read_char()
end

;; Try to read one key. Under `enable_raw_mode`'s `time 1` setting this
;; returns "" after ~100ms if nothing was pressed, and the parsed key name
;; otherwise. This is the non-blocking poll `run`'s main loop uses.
pub fn poll_key() -> string is
    let c1: string = read_one_byte()
    if c1 == "" is return "" end
    if c1 == "\x1b" is
        let c2: string = read_one_byte()
        if c2 == "" is return "esc" end
        if c2 == "[" || c2 == "O" is
            let c3: string = read_one_byte()
            if c3 == "A" is return "up" end
            if c3 == "B" is return "down" end
            if c3 == "C" is return "right" end
            if c3 == "D" is return "left" end
            if c3 == "H" is return "home" end
            if c3 == "F" is return "end" end
            if c3 == "3" is
                let _c4: string = read_one_byte()
                return "delete"
            end
            if c3 == "5" is
                let _c4: string = read_one_byte()
                return "pgup"
            end
            if c3 == "6" is
                let _c4: string = read_one_byte()
                return "pgdown"
            end
            return "esc"
        end
        return "esc"
    end
    if c1 == "\r" || c1 == "\n" is return "enter" end
    if c1 == "\t" is return "tab" end
    if c1 == "\x7f" || c1 == "\x08" is return "backspace" end
    if c1 == "\x03" is return "ctrl+c" end
    if c1 == "\x01" is return "ctrl+a" end
    if c1 == "\x05" is return "ctrl+e" end
    if c1 == "\x04" is return "ctrl+d" end
    if c1 == "\x15" is return "ctrl+u" end
    if c1 == "\x0b" is return "ctrl+k" end
    if c1 == "\x17" is return "ctrl+w" end
    if c1 == " " is return "space" end

    ;; Multi-byte UTF-8 lead byte (e.g. the first byte of "ą", "ł", "€", an
    ;; emoji, ...) — consume exactly as many continuation bytes as the lead
    ;; byte says, so one physical keypress reliably becomes one `poll_key()`
    ;; result instead of being split into several confusing fragments.
    ;;
    ;; KNOWN INTERPRETER BUG — verified against the actual H# interpreter
    ;; source, not a guess: `__builtin_io_read_char` returns
    ;; `(byte as char).to_string()`, which is only a correct byte<->char
    ;; mapping for ASCII (0-127). For a byte >= 128 it produces a
    ;; *different* multi-byte re-encoding of that byte's Latin-1 code
    ;; point instead of the original raw byte, so the numeric value this
    ;; block keys off of (`code`, below) survives, but the actual bytes
    ;; making up the reassembled string don't — a real non-ASCII key
    ;; still reads back as exactly one `poll_key()` event (so it won't
    ;; visually double up or desync later keys), but its *text* comes
    ;; through corrupted rather than as the real character. Concretely:
    ;; typing "ą" will not insert "ą" into a `textinput`. Plain ASCII
    ;; input (everything else in this function) is unaffected and has
    ;; been verified byte-for-byte correct. There is nothing this library
    ;; can do about the corruption itself from H# code — fixing it needs
    ;; `__builtin_io_read_char` itself changed to read raw bytes without
    ;; going through `char`.
    let code: int = __builtin_str_to_char_code(c1)
    let extra: int = utf8_extra_bytes(code)
    if extra > 0 is
        let mut ch: string = c1
        let mut k: int = 0
        while k < extra is
            ch = ch + read_one_byte()
            k = k + 1
        end
        return ch
    end

    return c1
end

fn utf8_extra_bytes(code: int) -> int is
    if code >= 240 is return 3 end
    if code >= 224 is return 2 end
    if code >= 192 is return 1 end
    return 0
end

;; True for every key name `poll_key` produces that ISN'T a plain
;; printable character — used by `textinput_update` (and useful in your
;; own `update`) to tell "the user typed a letter" apart from "the user
;; pressed a named/control key".
pub fn is_special_key(key: string) -> bool is
    if key == "up" || key == "down" || key == "left" || key == "right" is return true end
    if key == "home" || key == "end" || key == "pgup" || key == "pgdown" is return true end
    if key == "delete" || key == "backspace" || key == "tab" || key == "enter" is return true end
    if key == "esc" || key == "space" is return true end
    if key.len() >= 5 && key[0..5] == "ctrl+" is return true end
    return false
end

;; Block until a key is pressed (bypasses the ~100ms poll window). Handy
;; for a one-off "press any key to continue" prompt outside the main
;; `run` loop. Leaves raw mode exactly as it found it.
pub fn read_key_blocking() -> string is
    let _r: string = __builtin_process_run("stty min 1 time 0 -F /dev/tty 2>/dev/null")
    let key: string = poll_key()
    let _r2: string = __builtin_process_run("stty min 0 time 1 -F /dev/tty 2>/dev/null")
    return key
end


;; ── messages ─────────────────────────────────────────────────────────────

struct Msg is
    pub kind: string     ;; "key" | "tick" | "resize" | "quit" | "none" | "custom"
    pub key: string
    pub width: int
    pub height: int
    pub data: string
end

pub fn key_msg(key: string) -> any is
    return Msg { kind: "key", key: key, width: 0, height: 0, data: "" }
end

pub fn tick_msg(width: int, height: int) -> any is
    return Msg { kind: "tick", key: "", width: width, height: height, data: "" }
end

pub fn resize_msg(width: int, height: int) -> any is
    return Msg { kind: "resize", key: "", width: width, height: height, data: "" }
end

fn internal_quit_msg() -> any is
    return Msg { kind: "quit", key: "", width: 0, height: 0, data: "" }
end

pub fn quit_msg() -> any is
    return internal_quit_msg()
end

pub fn none_msg() -> any is
    return Msg { kind: "none", key: "", width: 0, height: 0, data: "" }
end

pub fn custom_msg(data: string) -> any is
    return Msg { kind: "custom", key: "", width: 0, height: 0, data: data }
end

pub fn msg_kind(m: any) -> string is
    return m.kind
end

pub fn msg_key(m: any) -> string is
    return m.key
end

pub fn msg_data(m: any) -> string is
    return m.data
end

pub fn msg_width(m: any) -> int is
    return m.width
end

pub fn msg_height(m: any) -> int is
    return m.height
end

pub fn msg_is(m: any, kind: string) -> bool is
    return m.kind == kind
end

pub fn msg_is_key(m: any, key: string) -> bool is
    return m.kind == "key" && m.key == key
end

pub fn msg_is_any_key(m: any) -> bool is
    return m.kind == "key"
end

pub fn msg_is_tick(m: any) -> bool is
    return m.kind == "tick"
end

pub fn msg_is_resize(m: any) -> bool is
    return m.kind == "resize"
end

pub fn msg_is_quit(m: any) -> bool is
    return m.kind == "quit"
end

pub fn msg_is_custom(m: any) -> bool is
    return m.kind == "custom"
end

;; True for the handful of keys that conventionally mean "leave the
;; screen": ctrl+c always, plus "q" and "esc" (only offer those two to
;; your own `update` as a *suggestion* — e.g. `if tui::should_quit(msg) ...`
;; — most real apps only want ctrl+c to be unconditional and want "q"/esc
;; to behave differently depending on which screen/mode they're in).
pub fn is_ctrl_c(m: any) -> bool is
    return m.kind == "key" && m.key == "ctrl+c"
end


;; ── commands ─────────────────────────────────────────────────────────────
;;
;; A `Cmd` is a zero-argument closure returning the next `Msg`. `run`'s
;; loop calls the `cmd` returned by `update` right away and feeds its
;; result back into `update` (bounded — see `run` below), the same shape
;; as Bubble Tea's `Cmd -> Msg -> Update` cycle, just synchronous instead
;; of running on a goroutine.

pub fn cmd_none() -> fn() -> any is
    return || -> any is
        return none_msg()
    end
end

pub fn cmd_quit() -> fn() -> any is
    return || -> any is
        return internal_quit_msg()
    end
end

pub fn cmd_custom(data: string) -> fn() -> any is
    return || -> any is
        return custom_msg(data)
    end
end

;; Sleeps `ms` milliseconds (blocking the render loop — there is no
;; background timer in this synchronous engine) then produces a tick
;; message. Useful for a deliberate delay between two update steps;
;; for a steady heartbeat just rely on `run`'s own ~100ms idle tick
;; instead of chaining `cmd_tick` in a loop.
pub fn cmd_tick(ms: int) -> fn() -> any is
    return || -> any is
        __builtin_time_sleep_ms(ms)
        return Msg { kind: "tick", key: "", width: 0, height: 0, data: "" }
    end
end


;; ── the program loop ─────────────────────────────────────────────────────
;;
;; `init`   : fn() -> any                 — build the first model
;; `update` : fn(any, any) -> any         — (model, msg) -> (new_model, cmd) tuple
;; `view`   : fn(any) -> string           — model -> the frame to draw
;;
;; `update`'s return value is a 2-tuple `(new_model, cmd)` — build it with a
;; plain `return (new_model, cmd)`; `cmd` is one of `tui::cmd_none()`,
;; `tui::cmd_quit()`, `tui::cmd_custom(data)`, `tui::cmd_tick(ms)`, or any
;; zero-argument closure of your own returning a `tui` message.
;;
;; The loop redraws on every pass: once per keypress, and once per ~100ms
;; idle tick when no key was pressed (driven by `enable_raw_mode`'s own
;; `time 1` read timeout) — so a `tui::msg_is_tick` message is how a
;; spinner or a clock keeps animating with nobody touching the keyboard.
;;
;; ctrl+c always exits, unconditionally, straight out of the loop, so a
;; misbehaving `update` can never strand the terminal in raw mode.
;;
;; Returns whatever the final model was when the program quit.
pub fn run(init: fn() -> any, update: fn(any, any) -> any, view: fn(any) -> string) -> any is
    let saved: string = enable_raw_mode()
    enter_alt_screen()
    hide_cursor()

    let mut model: any = init()
    let mut running: bool = true

    while running is
        draw(view(model))

        let key: string = poll_key()
        let msg: any = if key == "" is
            tick_msg(term_width(), term_height())
        else is
            if key == "ctrl+c" is
                internal_quit_msg()
            else is
                key_msg(key)
            end
        end

        if msg_is_quit(msg) is
            running = false
        else is
            let mut cur_msg: any = msg
            let mut steps: int = 0
            let mut keep_going: bool = true
            while keep_going && steps < 8 is
                let result: any = update(model, cur_msg)
                let (new_model, cmd) = result
                model = new_model
                let next_msg: any = cmd()
                if msg_is_quit(next_msg) is
                    running = false
                    keep_going = false
                else is
                    if msg_is(next_msg, "none") is
                        keep_going = false
                    else is
                        cur_msg = next_msg
                        steps = steps + 1
                    end
                end
            end
        end
    end

    show_cursor()
    exit_alt_screen()
    flush_out()
    disable_raw_mode(saved)
    return model
end

;; Same loop, but stops feeding `update` a synthetic tick when idle and
;; instead just blocks waiting for the next key — for apps that only ever
;; react to keypresses and don't want a background heartbeat at all (a
;; static menu, a confirmation prompt, ...). `cmd`s are still run the same
;; bounded (max 8) way as `run`.
pub fn run_no_tick(init: fn() -> any, update: fn(any, any) -> any, view: fn(any) -> string) -> any is
    let saved: string = enable_raw_mode()
    enter_alt_screen()
    hide_cursor()

    let mut model: any = init()
    let mut running: bool = true

    while running is
        draw(view(model))

        let mut key: string = poll_key()
        while key == "" is
            key = poll_key()
        end

        let msg: any = if key == "ctrl+c" is
            internal_quit_msg()
        else is
            key_msg(key)
        end

        if msg_is_quit(msg) is
            running = false
        else is
            let mut cur_msg: any = msg
            let mut steps: int = 0
            let mut keep_going: bool = true
            while keep_going && steps < 8 is
                let result: any = update(model, cur_msg)
                let (new_model, cmd) = result
                model = new_model
                let next_msg: any = cmd()
                if msg_is_quit(next_msg) is
                    running = false
                    keep_going = false
                else is
                    if msg_is(next_msg, "none") is
                        keep_going = false
                    else is
                        cur_msg = next_msg
                        steps = steps + 1
                    end
                end
            end
        end
    end

    show_cursor()
    exit_alt_screen()
    flush_out()
    disable_raw_mode(saved)
    return model
end


;; ── colors ───────────────────────────────────────────────────────────────
;;
;; A color is one of:
;;   ""            no color
;;   "#rrggbb"     24-bit truecolor hex
;;   "0".."255"    ANSI 256-color palette index
;;   a name        "black" "red" "green" "yellow" "blue" "magenta" "cyan"
;;                 "white" "bright_black" "bright_red" ... "bright_white"

fn named_color_code(name: string, base: int) -> string is
    ;; base is 30 for foreground, 40 for background
    if name == "black" is return to_string(base + 0) end
    if name == "red" is return to_string(base + 1) end
    if name == "green" is return to_string(base + 2) end
    if name == "yellow" is return to_string(base + 3) end
    if name == "blue" is return to_string(base + 4) end
    if name == "magenta" is return to_string(base + 5) end
    if name == "cyan" is return to_string(base + 6) end
    if name == "white" is return to_string(base + 7) end
    if name == "bright_black" is return to_string(base + 60) end
    if name == "bright_red" is return to_string(base + 61) end
    if name == "bright_green" is return to_string(base + 62) end
    if name == "bright_yellow" is return to_string(base + 63) end
    if name == "bright_blue" is return to_string(base + 64) end
    if name == "bright_magenta" is return to_string(base + 65) end
    if name == "bright_cyan" is return to_string(base + 66) end
    if name == "bright_white" is return to_string(base + 67) end
    return ""
end

;; Build the SGR escape for a foreground color (no leading "\x1b[" / no
;; trailing "m" — callers combine several codes into one escape).
fn fg_code(color: string) -> string is
    if color == "" is return "" end
    if color[0..1] == "#" && color.len() == 7 is
        let r: int = hex_pair_val(color, 1)
        let g: int = hex_pair_val(color, 3)
        let b: int = hex_pair_val(color, 5)
        return "38;2;" + to_string(r) + ";" + to_string(g) + ";" + to_string(b)
    end
    if is_all_digits(color) is
        return "38;5;" + color
    end
    let named: string = named_color_code(color, 30)
    if named != "" is return named end
    return ""
end

fn bg_code(color: string) -> string is
    if color == "" is return "" end
    if color[0..1] == "#" && color.len() == 7 is
        let r: int = hex_pair_val(color, 1)
        let g: int = hex_pair_val(color, 3)
        let b: int = hex_pair_val(color, 5)
        return "48;2;" + to_string(r) + ";" + to_string(g) + ";" + to_string(b)
    end
    if is_all_digits(color) is
        return "48;5;" + color
    end
    let named: string = named_color_code(color, 40)
    if named != "" is return named end
    return ""
end

;; Wrap `text` in a foreground-color escape. Handy for one-off coloring
;; without building a whole `Style`.
pub fn colorize(text: string, color: string) -> string is
    let code: string = fg_code(color)
    if code == "" is return text end
    return "\x1b[" + code + "m" + text + "\x1b[0m"
end


