;; fluent chaining sugar around the functions above — e.g.
;; `tui::style_new().with_fg("#7dd3fc").with_bold(true).render("hi")`
impl Style is
    fn with_fg(self, color: string) -> Style is return style_fg(self, color) end
    fn with_bg(self, color: string) -> Style is return style_bg(self, color) end
    fn with_bold(self, on: bool) -> Style is return style_bold(self, on) end
    fn with_italic(self, on: bool) -> Style is return style_italic(self, on) end
    fn with_underline(self, on: bool) -> Style is return style_underline(self, on) end
    fn with_width(self, w: int) -> Style is return style_width(self, w) end
    fn with_align(self, align: string) -> Style is return style_align(self, align) end
    fn with_padding(self, x: int, y: int) -> Style is return style_padding(self, x, y) end
    fn with_border(self, border: string) -> Style is return style_border(self, border) end
    fn with_border_color(self, color: string) -> Style is return style_border_color(self, color) end
    fn render(self, text: string) -> string is return style_render(self, text) end
end

fn sgr_prefix(bold: bool, italic: bool, underline: bool, fg: string, bg: string) -> string is
    let mut parts: [string] = []
    if bold is parts.push("1") end
    if italic is parts.push("3") end
    if underline is parts.push("4") end
    let f: string = fg_code(fg)
    if f != "" is parts.push(f) end
    let b: string = bg_code(bg)
    if b != "" is parts.push(b) end
    if parts.len() == 0 is return "" end
    return "\x1b[" + iter_join(parts, ";") + "m"
end

fn align_line(line: string, width: int, align: string) -> string is
    if align == "center" is return pad_center(line, width) end
    if align == "right" is return pad_left(line, width) end
    return pad_right(line, width)
end

fn max_line_width(lines: [string]) -> int is
    let mut m: int = 0
    for l in lines is
        let w: int = visible_len(l)
        if w > m is m = w end
    end
    return m
end

;; (horizontal, vertical, top-left, top-right, bottom-left, bottom-right)
fn border_chars(kind: string) -> (string, string, string, string, string, string) is
    if kind == "rounded" is return ("─", "│", "╭", "╮", "╰", "╯") end
    if kind == "thick" is return ("━", "┃", "┏", "┓", "┗", "┛") end
    if kind == "double" is return ("═", "║", "╔", "╗", "╚", "╝") end
    return ("─", "│", "┌", "┐", "└", "┘")
end

;; Render `text` (may be multi-line) through a style: color/attrs, fixed
;; width + alignment, padding, and an optional border. This doesn't
;; reflow/word-wrap long lines — it pads short ones and leaves long ones
;; as-is, same trade-off `std/fmt.h#`'s table helpers make.
pub fn style_render(s: any, text: string) -> string is
    let raw_lines: [string] = str_split(text, "\n")
    let content_width: int = if s.width > 0 is s.width else is max_line_width(raw_lines) end
    let prefix: string = sgr_prefix(s.bold, s.italic, s.underline, s.fg, s.bg)
    let reset: string = if prefix == "" is "" else is "\x1b[0m" end

    let mut body: [string] = []
    let blank: string = rep_str(" ", content_width + s.pad_x * 2)
    let mut py: int = 0
    while py < s.pad_y is
        body.push(prefix + blank + reset)
        py = py + 1
    end
    for line in raw_lines is
        let aligned: string = align_line(line, content_width, s.align)
        let inner: string = rep_str(" ", s.pad_x) + aligned + rep_str(" ", s.pad_x)
        body.push(prefix + inner + reset)
    end
    py = 0
    while py < s.pad_y is
        body.push(prefix + blank + reset)
        py = py + 1
    end

    if s.border == "none" is
        return iter_join(body, "\n")
    end

    let (h, v, tl, tr, bl, br) = border_chars(s.border)
    let border_prefix: string = if s.border_color == "" is "" else is "\x1b[" + fg_code(s.border_color) + "m" end
    let border_reset: string = if border_prefix == "" is "" else is "\x1b[0m" end
    let inner_width: int = content_width + s.pad_x * 2
    let top: string = border_prefix + tl + rep_str(h, inner_width) + tr + border_reset
    let bottom: string = border_prefix + bl + rep_str(h, inner_width) + br + border_reset

    let mut out: [string] = []
    out.push(top)
    for line in body is
        out.push(border_prefix + v + border_reset + line + border_prefix + v + border_reset)
    end
    out.push(bottom)
    return iter_join(out, "\n")
end


;; ── layout helpers (Lip Gloss-style block joining) ──────────────────────

;; Lay several (possibly multi-line) blocks side by side, `gap` spaces
;; apart, bottom-padding the shorter ones so ragged heights still line up.
pub fn join_horizontal(blocks: [string], gap: int) -> string is
    let mut cols: [[string]] = []
    let mut widths: [int] = []
    let mut max_h: int = 0
    for b in blocks is
        let ls: [string] = str_split(b, "\n")
        cols.push(ls)
        widths.push(max_line_width(ls))
        if ls.len() > max_h is max_h = ls.len() end
    end
    let mut out_lines: [string] = []
    let mut row: int = 0
    while row < max_h is
        let mut line: string = ""
        let mut bi: int = 0
        while bi < cols.len() is
            let ls: [string] = cols[bi]
            let w: int = widths[bi]
            let cell: string = if row < ls.len() is pad_right(ls[row], w) else is rep_str(" ", w) end
            line = line + cell
            if bi < cols.len() - 1 is
                line = line + rep_str(" ", gap)
            end
            bi = bi + 1
        end
        out_lines.push(line)
        row = row + 1
    end
    return iter_join(out_lines, "\n")
end

;; Stack blocks top to bottom.
pub fn join_vertical(blocks: [string]) -> string is
    return iter_join(blocks, "\n")
end

;; Center a (possibly multi-line) block inside a `width` x `height` box of
;; spaces.
pub fn center_block(s: string, width: int, height: int) -> string is
    let lines: [string] = str_split(s, "\n")
    let content_h: int = lines.len()
    let top_pad: int = maxi(0, (height - content_h) / 2)
    let bottom_pad: int = maxi(0, height - content_h - top_pad)
    let mut out: [string] = []
    let mut i: int = 0
    while i < top_pad is
        out.push(rep_str(" ", width))
        i = i + 1
    end
    for l in lines is
        out.push(pad_center(l, width))
    end
    i = 0
    while i < bottom_pad is
        out.push(rep_str(" ", width))
        i = i + 1
    end
    return iter_join(out, "\n")
end


;; ── component: spinner ───────────────────────────────────────────────────

struct Spinner is
    pub frames: [string]
    pub frame_idx: int
    pub style: any
end

fn spinner_frames_for(kind: string) -> [string] is
    if kind == "line" is return ["-", "\\", "|", "/"] end
    if kind == "circle" is return ["◐", "◓", "◑", "◒"] end
    if kind == "arrow" is return ["←", "↖", "↑", "↗", "→", "↘", "↓", "↙"] end
    if kind == "bounce" is return ["⠁", "⠂", "⠄", "⠂"] end
    if kind == "pulse" is return ["∙", "●", "∙"] end
    if kind == "bar" is return ["▁", "▃", "▄", "▅", "▆", "▇", "█", "▇", "▆", "▅", "▄", "▃"] end
    ;; "dot" (default) — the classic Bubble Tea braille spinner
    return ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
end

;; kind: "dot" (default) | "line" | "circle" | "arrow" | "bounce" | "pulse" | "bar"
pub fn spinner_new(kind: string) -> any is
    return Spinner { frames: spinner_frames_for(kind), frame_idx: 0, style: style_new() }
end

;; Advance to the next frame — call this once per tick you want it to spin.
pub fn spinner_tick(sp: any) -> any is
    let n: int = sp.frames.len()
    return Spinner { frames: sp.frames, frame_idx: (sp.frame_idx + 1) % n, style: sp.style }
end

pub fn spinner_set_style(sp: any, style: any) -> any is
    return Spinner { frames: sp.frames, frame_idx: sp.frame_idx, style: style }
end

pub fn spinner_view(sp: any) -> string is
    return style_render(sp.style, sp.frames[sp.frame_idx])
end


